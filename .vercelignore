# Vercel hosts the frontend (web/) and the read API (api/) only. The collector,
# metrics pipeline, migrations and every fixture stay out of the upload.
.venv
**/.venv
node_modules
**/node_modules
.fixtures
metrics
tests
scripts
# A bare name matches at any depth, so `scripts` also matches web/scripts/. Its
# check-bundle.mjs is a build gate that `npm run build` runs, so it stays in the upload
# (tests/test_deploy_config.py).
!web/scripts/
!web/scripts/**
supabase
api/tests
web/dist
