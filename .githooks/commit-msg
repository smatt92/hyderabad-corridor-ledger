#!/bin/sh
# Rejects forbidden attribution text before the commit is created.
# CI applies the same list to the full history: scripts/ci/check-authorship.sh
patterns="$(git rev-parse --show-toplevel)/scripts/ci/forbidden-commit-text.txt"

# Ignore the verbose diff below the scissors line and comment lines.
if hits=$(sed '/^# -\{24\} >8 -\{24\}$/,$d' "$1" | git stripspace --strip-comments | grep -ioF -f "$patterns"); then
  echo "commit-msg: message contains forbidden text: $hits (see CLAUDE.md)" >&2
  exit 1
fi
